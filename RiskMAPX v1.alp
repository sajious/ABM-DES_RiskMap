								<Code><![CDATA[if(self.in.count() == 1){
TotalRiskC = agent.TotalRiskC;
TotalRiskI = agent.TotalRiskI;
TotalRiskA = agent.TotalRiskA;
}

if(self.in.count() == 2){
	NewTotalRiskC = agent.TotalRiskC;
	NewTotalRiskI = agent.TotalRiskI;
	NewTotalRiskA = agent.TotalRiskA;
	
	ReducedRiskC = TotalRiskC - NewTotalRiskC;
	ReducedRiskI = TotalRiskI - NewTotalRiskI;
	ReducedRiskA = TotalRiskA - NewTotalRiskA;
}]]></Code>
