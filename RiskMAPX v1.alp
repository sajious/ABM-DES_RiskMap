					<Id>1701961642962</Id>
					<Name><![CDATA[sink1]]></Name>
					<X>30370</X><Y>5320</Y>
					<Label><X>-10</X><Y>-20</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<ActiveObjectClass>
						<PackageName><![CDATA[com.anylogic.libraries.processmodeling]]></PackageName>
						<ClassName><![CDATA[Sink]]></ClassName>
					</ActiveObjectClass>
					<GenericParameterSubstitute>
						<GenericParameterSubstituteReference>
							<PackageName><![CDATA[com.anylogic.libraries.processmodeling]]></PackageName>
							<ClassName><![CDATA[Sink]]></ClassName>
							<ItemName><![CDATA[1412336242929]]></ItemName>
						</GenericParameterSubstituteReference>
						<GenericParameterSubstituteValue Class="CodeValue">
							<Code><![CDATA[FlowAgent]]></Code>
						</GenericParameterSubstituteValue>
					</GenericParameterSubstitute>
					<Parameters>
						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[Threat Thtemp;

Thtemp = Collections.max(AllThreats, Comparator.comparing(obj -> obj.TotalRiskC));
OptimalSelector.Threats_GlobalMaxTotalRiskC = Thtemp.TotalRiskC;

Thtemp = Collections.max(AllThreats, Comparator.comparing(obj -> obj.TotalRiskI));
OptimalSelector.Threats_GlobalMaxTotalRiskI = Thtemp.TotalRiskI;

Thtemp = Collections.max(AllThreats, Comparator.comparing(obj -> obj.TotalRiskA));
OptimalSelector.Threats_GlobalMaxTotalRiskA = Thtemp.TotalRiskA;

Thtemp = Collections.min(AllThreats, Comparator.comparing(obj -> obj.TotalRiskC));
OptimalSelector.Threats_GlobalMinTotalRiskC = Thtemp.TotalRiskC;

Thtemp = Collections.min(AllThreats, Comparator.comparing(obj -> obj.TotalRiskI));
OptimalSelector.Threats_GlobalMinTotalRiskI = Thtemp.TotalRiskI;

Thtemp = Collections.min(AllThreats, Comparator.comparing(obj -> obj.TotalRiskA));
OptimalSelector.Threats_GlobalMinTotalRiskA = Thtemp.TotalRiskA;

OptimalSelector.Threats_RangeTotalRiskC = OptimalSelector.Threats_GlobalMaxTotalRiskC - OptimalSelector.Threats_GlobalMinTotalRiskC;
OptimalSelector.Threats_RangeTotalRiskI = OptimalSelector.Threats_GlobalMaxTotalRiskI - OptimalSelector.Threats_GlobalMinTotalRiskI;
OptimalSelector.Threats_RangeTotalRiskA = OptimalSelector.Threats_GlobalMaxTotalRiskA - OptimalSelector.Threats_GlobalMinTotalRiskA;

for(Threat x:AllThreats){
	
	x.TotalRiskC = roundToDecimal((( x.TotalRiskC - OptimalSelector.Threats_GlobalMinTotalRiskC ) / OptimalSelector.Threats_RangeTotalRiskC)*9+1,4);
	x.TotalRiskI = roundToDecimal((( x.TotalRiskI - OptimalSelector.Threats_GlobalMinTotalRiskI ) / OptimalSelector.Threats_RangeTotalRiskI)*9+1,4);
	x.TotalRiskA = roundToDecimal((( x.TotalRiskA - OptimalSelector.Threats_GlobalMinTotalRiskA ) / OptimalSelector.Threats_RangeTotalRiskA)*9+1,4);
		
}

source2.inject(1);

]]></Code>
							</Value>
						</Parameter>
