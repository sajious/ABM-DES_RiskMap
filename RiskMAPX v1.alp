						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[if(self.in.count() == 1){
agent.TotalRiskC = TotalRiskC;
agent.TotalRiskI = TotalRiskI;
agent.TotalRiskA = TotalRiskA;
}

if(self.in.count() == 2){
	if(!main.OptimalSelector.OptimalCMs.isEmpty() && main.OptimalSelector.OptimalCMs.get(0).ThreatsCanAddress.contains(this)){
	
		for(RiskReductionForThreats rrt:main.OptimalSelector.OptimalCMs.get(0).riskReductionsForThreats){
			if(rrt.ThreatID.equals(ID)){
				CMSelectedRRC = rrt.RiskReductionC;
				CMSelectedRRI = rrt.RiskReductionI;
				CMSelectedRRA = rrt.RiskReductionA;
			}
		}
	
	NewTotalRiskC = TotalRiskC * (1 - CMSelectedRRC );
	NewTotalRiskI = TotalRiskI * (1 - CMSelectedRRI );
	NewTotalRiskA = TotalRiskA * (1 - CMSelectedRRI );
	
	ReducedRiskC = TotalRiskC - NewTotalRiskC;
	ReducedRiskI = TotalRiskI - NewTotalRiskI;
	ReducedRiskA = TotalRiskA - NewTotalRiskA;
	
	agent.TotalRiskC = NewTotalRiskC ;
	agent.TotalRiskI = NewTotalRiskI ;
	agent.TotalRiskA = NewTotalRiskA ;
	}
}

]]></Code>
							</Value>
