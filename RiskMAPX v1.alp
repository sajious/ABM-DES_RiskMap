							<Value Class="CodeValue">
								<Code><![CDATA[for(Threat t:main.AllThreats){
	for(RiskReductionForThreats r1:riskReductionsForThreats){
		if(r1.ThreatID.equals(t.ID)){
		ThreatsRiskReductionCoverageC += r1.RiskReductionC * t.RelWeightC;
		ThreatsRiskReductionCoverageI += r1.RiskReductionI * t.RelWeightI;
		ThreatsRiskReductionCoverageA += r1.RiskReductionA * t.RelWeightA;
		}
	}
}]]></Code>
