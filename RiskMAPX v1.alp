		<!--   =========   Active Object Class   ========  -->
		<ActiveObjectClass>
			<Id>1699625671459</Id>
			<Name><![CDATA[Threat]]></Name>
			<StartupCode><![CDATA[main.AllThreats.add(this);

for(Vulnerability v:main.AllVulnerabilities){
	if(RelatedVulnerability.equals(v.CVE_ID)){
		TotalRiskC = v.CVSS_ScoreC*v.ImpactScoreC*v.LikelihoodScore;
		TotalRiskI = v.CVSS_ScoreI*v.ImpactScoreI*v.LikelihoodScore;
		TotalRiskA = v.CVSS_ScoreA*v.ImpactScoreA*v.LikelihoodScore;
	}
}]]></StartupCode>
			<Generic>false</Generic>
