				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1701431487388</Id>
					<Name><![CDATA[optimalSelection]]></Name>
					<X>40</X><Y>400</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[OptimalCMs.addAll(CMSet);
OptimalCMs.sort((o1, o2) -> Double.compare(o1.CMUtilityScore, o2.CMUtilityScore));
Collections.reverse(OptimalCMs);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1701431487392</Id>
					<Name><![CDATA[cmToAddressingSelectedThreats]]></Name>
					<X>40</X><Y>300</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[for(Countermeasure c:main.AllCountermeasures){
	if(c.ThreatsCanAddress.contains(main.MostImportantThreat) && c.TotalCost <= main.MaxBudget && c.hasBeenDeployed == false){
		CMSet.add(c);
		c.rectangle.setLineColor(green);
		c.rectangle.setLineWidth(6);
	}
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1701431487394</Id>
					<Name><![CDATA[globalMaxCalculation]]></Name>
					<X>40</X><Y>160</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[Objective Otemp;
Task Ttemp;
Asset Atemp;
Threat Thtemp;
Countermeasure Ctemp;
//----------------------------------
Otemp = Collections.max(main.AllMissionObjectives, Comparator.comparing(obj -> obj.RelWeightC));
MO_GlobalMaxRelWeightC = Otemp.RelWeightC;

Otemp = Collections.max(main.AllMissionObjectives, Comparator.comparing(obj -> obj.RelWeightI));
MO_GlobalMaxRelWeightI = Otemp.RelWeightI;

Otemp = Collections.max(main.AllMissionObjectives, Comparator.comparing(obj -> obj.RelWeightA));
MO_GlobalMaxRelWeightA = Otemp.RelWeightA;

Otemp = Collections.max(main.AllMissionObjectives, Comparator.comparing(obj -> obj.TotalRiskC));
MO_GlobalMaxTotalRiskC = Otemp.TotalRiskC;

Otemp = Collections.max(main.AllMissionObjectives, Comparator.comparing(obj -> obj.TotalRiskI));
MO_GlobalMaxTotalRiskI = Otemp.TotalRiskI;

Otemp = Collections.max(main.AllMissionObjectives, Comparator.comparing(obj -> obj.TotalRiskA));
MO_GlobalMaxTotalRiskA = Otemp.TotalRiskA;

//----------------------------------
Ttemp = Collections.max(main.AllTasks, Comparator.comparing(obj -> obj.RelWeightC));
Tasks_GlobalMaxRelWeightC = Ttemp.RelWeightC;

Ttemp = Collections.max(main.AllTasks, Comparator.comparing(obj -> obj.RelWeightI));
Tasks_GlobalMaxRelWeightI = Ttemp.RelWeightI;

Ttemp = Collections.max(main.AllTasks, Comparator.comparing(obj -> obj.RelWeightA));
Tasks_GlobalMaxRelWeightA = Ttemp.RelWeightA;

Ttemp = Collections.max(main.AllTasks, Comparator.comparing(obj -> obj.TotalRiskC));
Tasks_GlobalMaxTotalRiskC = Ttemp.TotalRiskC;

Ttemp = Collections.max(main.AllTasks, Comparator.comparing(obj -> obj.TotalRiskI));
Tasks_GlobalMaxTotalRiskI = Ttemp.TotalRiskI;

Ttemp = Collections.max(main.AllTasks, Comparator.comparing(obj -> obj.TotalRiskA));
Tasks_GlobalMaxTotalRiskA = Ttemp.TotalRiskA;

//----------------------------------
Atemp = Collections.max(main.AllAssets, Comparator.comparing(obj -> obj.RelWeightC));
Assets_GlobalMaxRelWeightC = Atemp.RelWeightC;

Atemp = Collections.max(main.AllAssets, Comparator.comparing(obj -> obj.RelWeightI));
Assets_GlobalMaxRelWeightI = Atemp.RelWeightI;

Atemp = Collections.max(main.AllAssets, Comparator.comparing(obj -> obj.RelWeightA));
Assets_GlobalMaxRelWeightA = Atemp.RelWeightA;

Atemp = Collections.max(main.AllAssets, Comparator.comparing(obj -> obj.TotalRiskC));
Assets_GlobalMaxTotalRiskC = Atemp.TotalRiskC;

Atemp = Collections.max(main.AllAssets, Comparator.comparing(obj -> obj.TotalRiskI));
Assets_GlobalMaxTotalRiskI = Atemp.TotalRiskI;

Atemp = Collections.max(main.AllAssets, Comparator.comparing(obj -> obj.TotalRiskA));
Assets_GlobalMaxTotalRiskA = Atemp.TotalRiskA;

//----------------------------------
Thtemp = Collections.max(main.AllThreats, Comparator.comparing(obj -> obj.RelWeightC));
Threats_GlobalMaxRelWeightC = Thtemp.RelWeightC;

Thtemp = Collections.max(main.AllThreats, Comparator.comparing(obj -> obj.RelWeightI));
Threats_GlobalMaxRelWeightI = Thtemp.RelWeightI;

Thtemp = Collections.max(main.AllThreats, Comparator.comparing(obj -> obj.RelWeightA));
Threats_GlobalMaxRelWeightA = Thtemp.RelWeightA;


//----------------------------------

Ctemp = Collections.max(main.AllCountermeasures, Comparator.comparing(obj -> obj.TotalCost));
Countermeasures_GlobalMaxTotalCost = Ctemp.TotalCost;

Ctemp = Collections.max(main.AllCountermeasures, Comparator.comparing(obj -> obj.ThreatsRiskReductionCoverageC));
Countermeasures_GlobalMaxTRRCC = Ctemp.ThreatsRiskReductionCoverageC;

Ctemp = Collections.max(main.AllCountermeasures, Comparator.comparing(obj -> obj.ThreatsRiskReductionCoverageI));
Countermeasures_GlobalMaxTRRCI = Ctemp.ThreatsRiskReductionCoverageI;

Ctemp = Collections.max(main.AllCountermeasures, Comparator.comparing(obj -> obj.ThreatsRiskReductionCoverageA));
Countermeasures_GlobalMaxTRRCA = Ctemp.ThreatsRiskReductionCoverageA;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1701431487396</Id>
					<Name><![CDATA[normalize]]></Name>
					<X>40</X><Y>240</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[for(Objective x:main.AllMissionObjectives){
	//x.TotalRiskC = roundToDecimal((( x.TotalRiskC - MO_GlobalMinTotalRiskC ) / MO_RangeTotalRiskC)*9+1,4);
	//x.TotalRiskI = roundToDecimal((( x.TotalRiskI - MO_GlobalMinTotalRiskI ) / MO_RangeTotalRiskI)*9+1,4);
	//x.TotalRiskA = roundToDecimal((( x.TotalRiskA - MO_GlobalMinTotalRiskA ) / MO_RangeTotalRiskA)*9+1,4);
}

for(Task x:main.AllTasks){
	x.RelWeightC = roundToDecimal((( x.RelWeightC - Tasks_GlobalMinRelWeightC ) / Tasks_RangeRelWeightC)*9+1,4);
	x.RelWeightI = roundToDecimal((( x.RelWeightI - Tasks_GlobalMinRelWeightI ) / Tasks_RangeRelWeightI)*9+1,4);
	x.RelWeightA = roundToDecimal((( x.RelWeightA - Tasks_GlobalMinRelWeightA ) / Tasks_RangeRelWeightA)*9+1,4);
	
	//x.TotalRiskC = roundToDecimal((( x.TotalRiskC - Tasks_GlobalMinTotalRiskC ) / Tasks_RangeTotalRiskC)*9+1,4);
	//x.TotalRiskI = roundToDecimal((( x.TotalRiskI - Tasks_GlobalMinTotalRiskI ) / Tasks_RangeTotalRiskI)*9+1,4);
	//x.TotalRiskA = roundToDecimal((( x.TotalRiskA - Tasks_GlobalMinTotalRiskA ) / Tasks_RangeTotalRiskA)*9+1,4);
}

for(Asset x:main.AllAssets){
	x.RelWeightC = roundToDecimal((( x.RelWeightC - Assets_GlobalMinRelWeightC ) / Assets_RangeRelWeightC)*9+1,4);
	x.RelWeightI = roundToDecimal((( x.RelWeightI - Assets_GlobalMinRelWeightI ) / Assets_RangeRelWeightI)*9+1,4);
	x.RelWeightA = roundToDecimal((( x.RelWeightA - Assets_GlobalMinRelWeightA ) / Assets_RangeRelWeightA)*9+1,4);
	
	//x.TotalRiskC = roundToDecimal((( x.TotalRiskC - Assets_GlobalMinTotalRiskC ) / Assets_RangeTotalRiskC)*9+1,4);
	//x.TotalRiskI = roundToDecimal((( x.TotalRiskI - Assets_GlobalMinTotalRiskI ) / Assets_RangeTotalRiskI)*9+1,4);
	//x.TotalRiskA = roundToDecimal((( x.TotalRiskA - Assets_GlobalMinTotalRiskA ) / Assets_RangeTotalRiskA)*9+1,4);
}

for(Threat x:main.AllThreats){
	x.RelWeightC = roundToDecimal((( x.RelWeightC - Threats_GlobalMinRelWeightC ) / Threats_RangeRelWeightC)*9+1,4);
	x.RelWeightI = roundToDecimal((( x.RelWeightI - Threats_GlobalMinRelWeightI ) / Threats_RangeRelWeightI)*9+1,4);
	x.RelWeightA = roundToDecimal((( x.RelWeightA - Threats_GlobalMinRelWeightA ) / Threats_RangeRelWeightA)*9+1,4);
	
	//x.TotalRiskC = roundToDecimal((( x.TotalRiskC - Threats_GlobalMinTotalRiskC ) / Threats_RangeTotalRiskC)*9+1,4);
	//x.TotalRiskI = roundToDecimal((( x.TotalRiskI - Threats_GlobalMinTotalRiskI ) / Threats_RangeTotalRiskI)*9+1,4);
	//x.TotalRiskA = roundToDecimal((( x.TotalRiskA - Threats_GlobalMinTotalRiskA ) / Threats_RangeTotalRiskA)*9+1,4);
	
	
}

for(Countermeasure x:main.AllCountermeasures){
	x.ThreatsRiskReductionCoverageC = roundToDecimal((( x.ThreatsRiskReductionCoverageC - Countermeasures_GlobalMinTRRCC ) / Countermeasures_RangeTRRCC)*9+1,4);
	x.ThreatsRiskReductionCoverageI = roundToDecimal((( x.ThreatsRiskReductionCoverageI - Countermeasures_GlobalMinTRRCI ) / Countermeasures_RangeTRRCI)*9+1,4);
	x.ThreatsRiskReductionCoverageA = roundToDecimal((( x.ThreatsRiskReductionCoverageA - Countermeasures_GlobalMinTRRCA ) / Countermeasures_RangeTRRCA)*9+1,4);

}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1701503357227</Id>
					<Name><![CDATA[calculateCMUtitlityScore]]></Name>
					<X>40</X><Y>380</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[for(Countermeasure c:main.AllCountermeasures){
	c.CMUtilityScore = 
	roundToDecimal(
		( W_RR * c.RRScore + W_TRRC * c.TRRCScore)
	  	-
	  	( W_DC * c.CostScore + W_QS * c.NegativeImpactScore),6);
}
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1701963742301</Id>
					<Name><![CDATA[threatToAddressingSelection]]></Name>
					<X>40</X><Y>280</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[Threat ThtempTotal = Collections.max(main.AllThreats, Comparator.comparing(obj -> obj.PriorityScore));

for(Threat t:main.AllThreats){
	if(t.PriorityScore >= ThtempTotal.PriorityScore){
	main.MostImportantThreat = t;
	t.rectangle.setLineColor(red);
	t.rectangle.setLineWidth(3);
	}
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1702835048055</Id>
					<Name><![CDATA[globalMinCalculation]]></Name>
					<X>40</X><Y>180</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[Objective Otemp;
Task Ttemp;
Asset Atemp;
Threat Thtemp;
Countermeasure Ctemp;
//----------------------------------
Otemp = Collections.min(main.AllMissionObjectives, Comparator.comparing(obj -> obj.RelWeightC));
MO_GlobalMinRelWeightC = Otemp.RelWeightC;

Otemp = Collections.min(main.AllMissionObjectives, Comparator.comparing(obj -> obj.RelWeightI));
MO_GlobalMinRelWeightI = Otemp.RelWeightI;

Otemp = Collections.min(main.AllMissionObjectives, Comparator.comparing(obj -> obj.RelWeightA));
MO_GlobalMinRelWeightA = Otemp.RelWeightA;

Otemp = Collections.min(main.AllMissionObjectives, Comparator.comparing(obj -> obj.TotalRiskC));
MO_GlobalMinTotalRiskC = Otemp.TotalRiskC;

Otemp = Collections.min(main.AllMissionObjectives, Comparator.comparing(obj -> obj.TotalRiskI));
MO_GlobalMinTotalRiskI = Otemp.TotalRiskI;

Otemp = Collections.min(main.AllMissionObjectives, Comparator.comparing(obj -> obj.TotalRiskA));
MO_GlobalMinTotalRiskA = Otemp.TotalRiskA;

//----------------------------------
Ttemp = Collections.min(main.AllTasks, Comparator.comparing(obj -> obj.RelWeightC));
Tasks_GlobalMinRelWeightC = Ttemp.RelWeightC;

Ttemp = Collections.min(main.AllTasks, Comparator.comparing(obj -> obj.RelWeightI));
Tasks_GlobalMinRelWeightI = Ttemp.RelWeightI;

Ttemp = Collections.min(main.AllTasks, Comparator.comparing(obj -> obj.RelWeightA));
Tasks_GlobalMinRelWeightA = Ttemp.RelWeightA;

Ttemp = Collections.min(main.AllTasks, Comparator.comparing(obj -> obj.TotalRiskC));
Tasks_GlobalMinTotalRiskC = Ttemp.TotalRiskC;

Ttemp = Collections.min(main.AllTasks, Comparator.comparing(obj -> obj.TotalRiskI));
Tasks_GlobalMinTotalRiskI = Ttemp.TotalRiskI;

Ttemp = Collections.min(main.AllTasks, Comparator.comparing(obj -> obj.TotalRiskA));
Tasks_GlobalMinTotalRiskA = Ttemp.TotalRiskA;

//----------------------------------
Atemp = Collections.min(main.AllAssets, Comparator.comparing(obj -> obj.RelWeightC));
Assets_GlobalMinRelWeightC = Atemp.RelWeightC;

Atemp = Collections.min(main.AllAssets, Comparator.comparing(obj -> obj.RelWeightI));
Assets_GlobalMinRelWeightI = Atemp.RelWeightI;

Atemp = Collections.min(main.AllAssets, Comparator.comparing(obj -> obj.RelWeightA));
Assets_GlobalMinRelWeightA = Atemp.RelWeightA;

Atemp = Collections.min(main.AllAssets, Comparator.comparing(obj -> obj.TotalRiskC));
Assets_GlobalMinTotalRiskC = Atemp.TotalRiskC;

Atemp = Collections.min(main.AllAssets, Comparator.comparing(obj -> obj.TotalRiskI));
Assets_GlobalMinTotalRiskI = Atemp.TotalRiskI;

Atemp = Collections.min(main.AllAssets, Comparator.comparing(obj -> obj.TotalRiskA));
Assets_GlobalMinTotalRiskA = Atemp.TotalRiskA;

//----------------------------------
Thtemp = Collections.min(main.AllThreats, Comparator.comparing(obj -> obj.RelWeightC));
Threats_GlobalMinRelWeightC = Thtemp.RelWeightC;

Thtemp = Collections.min(main.AllThreats, Comparator.comparing(obj -> obj.RelWeightI));
Threats_GlobalMinRelWeightI = Thtemp.RelWeightI;

Thtemp = Collections.min(main.AllThreats, Comparator.comparing(obj -> obj.RelWeightA));
Threats_GlobalMinRelWeightA = Thtemp.RelWeightA;


//----------------------------------

Ctemp = Collections.min(main.AllCountermeasures, Comparator.comparing(obj -> obj.TotalCost));
Countermeasures_GlobalMinTotalCost = Ctemp.TotalCost;

Ctemp = Collections.min(main.AllCountermeasures, Comparator.comparing(obj -> obj.ThreatsRiskReductionCoverageC));
Countermeasures_GlobalMaxTRRCC = Ctemp.ThreatsRiskReductionCoverageC;

Ctemp = Collections.min(main.AllCountermeasures, Comparator.comparing(obj -> obj.ThreatsRiskReductionCoverageI));
Countermeasures_GlobalMaxTRRCI = Ctemp.ThreatsRiskReductionCoverageI;

Ctemp = Collections.max(main.AllCountermeasures, Comparator.comparing(obj -> obj.ThreatsRiskReductionCoverageA));
Countermeasures_GlobalMaxTRRCA = Ctemp.ThreatsRiskReductionCoverageA;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1702836056734</Id>
					<Name><![CDATA[rangeCalculation]]></Name>
					<X>40</X><Y>200</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[MO_RangeRelWeightC = MO_GlobalMaxRelWeightC - MO_GlobalMinRelWeightC;
MO_RangeRelWeightI = MO_GlobalMaxRelWeightI - MO_GlobalMinRelWeightI;
MO_RangeRelWeightA = MO_GlobalMaxRelWeightA - MO_GlobalMinRelWeightA;
MO_RangeTotalRiskC = MO_GlobalMaxTotalRiskC - MO_GlobalMinTotalRiskC;
MO_RangeTotalRiskI = MO_GlobalMaxTotalRiskI - MO_GlobalMinTotalRiskI;
MO_RangeTotalRiskA = MO_GlobalMaxTotalRiskA - MO_GlobalMinTotalRiskA;

Tasks_RangeRelWeightC = Tasks_GlobalMaxRelWeightC - Tasks_GlobalMinRelWeightC;
Tasks_RangeRelWeightI = Tasks_GlobalMaxRelWeightI - Tasks_GlobalMinRelWeightI;
Tasks_RangeRelWeightA = Tasks_GlobalMaxRelWeightA - Tasks_GlobalMinRelWeightA;
Tasks_RangeTotalRiskC = Tasks_GlobalMaxTotalRiskC - Tasks_GlobalMinTotalRiskC;
Tasks_RangeTotalRiskI = Tasks_GlobalMaxTotalRiskI - Tasks_GlobalMinTotalRiskI;
Tasks_RangeTotalRiskA = Tasks_GlobalMaxTotalRiskA - Tasks_GlobalMinTotalRiskA;

Assets_RangeRelWeightC = Assets_GlobalMaxRelWeightC - Assets_GlobalMinRelWeightC;
Assets_RangeRelWeightI = Assets_GlobalMaxRelWeightI - Assets_GlobalMinRelWeightI;
Assets_RangeRelWeightA = Assets_GlobalMaxRelWeightA - Assets_GlobalMinRelWeightA;
Assets_RangeTotalRiskC = Assets_GlobalMaxTotalRiskC - Assets_GlobalMinTotalRiskC;
Assets_RangeTotalRiskI = Assets_GlobalMaxTotalRiskI - Assets_GlobalMinTotalRiskI;
Assets_RangeTotalRiskA = Assets_GlobalMaxTotalRiskA - Assets_GlobalMinTotalRiskA;

Threats_RangeRelWeightC = Threats_GlobalMaxRelWeightC - Threats_GlobalMinRelWeightC;
Threats_RangeRelWeightI = Threats_GlobalMaxRelWeightI - Threats_GlobalMinRelWeightI;
Threats_RangeRelWeightA = Threats_GlobalMaxRelWeightA - Threats_GlobalMinRelWeightA;

Countermeasures_RangeTotalCost = Countermeasures_GlobalMaxTotalCost - Countermeasures_GlobalMinTotalCost;
Countermeasures_RangeTRRCC = Countermeasures_GlobalMaxTRRCC - Countermeasures_GlobalMinTRRCC;
Countermeasures_RangeTRRCI = Countermeasures_GlobalMaxTRRCI - Countermeasures_GlobalMinTRRCI;
Countermeasures_RangeTRRCA = Countermeasures_GlobalMaxTRRCA - Countermeasures_GlobalMinTRRCA;




























 ]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1702842865648</Id>
					<Name><![CDATA[checkRange]]></Name>
					<X>40</X><Y>220</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[MO_RangeRelWeightC = (MO_RangeRelWeightC == 0) ? 1 : MO_RangeRelWeightC;
MO_RangeRelWeightI = (MO_RangeRelWeightI == 0) ? 1 : MO_RangeRelWeightI;
MO_RangeRelWeightA = (MO_RangeRelWeightA == 0) ? 1 : MO_RangeRelWeightA;
MO_RangeTotalRiskC = (MO_RangeTotalRiskC == 0) ? 1 : MO_RangeTotalRiskC;
MO_RangeTotalRiskI = (MO_RangeTotalRiskI == 0) ? 1 : MO_RangeTotalRiskI;
MO_RangeTotalRiskA = (MO_RangeTotalRiskA == 0) ? 1 : MO_RangeTotalRiskA;

Tasks_RangeRelWeightC = (Tasks_RangeRelWeightC == 0) ? 1: Tasks_RangeRelWeightC;
Tasks_RangeRelWeightI = (Tasks_RangeRelWeightI == 0) ? 1: Tasks_RangeRelWeightI;
Tasks_RangeRelWeightA = (Tasks_RangeRelWeightA == 0) ? 1: Tasks_RangeRelWeightA;
Tasks_RangeTotalRiskC = (Tasks_RangeTotalRiskC == 0) ? 1: Tasks_RangeTotalRiskC;
Tasks_RangeTotalRiskI = (Tasks_RangeTotalRiskI == 0) ? 1: Tasks_RangeTotalRiskI;
Tasks_RangeTotalRiskA = (Tasks_RangeTotalRiskA == 0) ? 1: Tasks_RangeTotalRiskA;

Assets_RangeRelWeightC = (Assets_RangeRelWeightC == 0) ? 1: Assets_RangeRelWeightC;
Assets_RangeRelWeightI = (Assets_RangeRelWeightI == 0) ? 1: Assets_RangeRelWeightI;
Assets_RangeRelWeightA = (Assets_RangeRelWeightA == 0) ? 1: Assets_RangeRelWeightA;
Assets_RangeTotalRiskC = (Assets_RangeTotalRiskC == 0) ? 1: Assets_RangeTotalRiskC;
Assets_RangeTotalRiskI = (Assets_RangeTotalRiskI == 0) ? 1: Assets_RangeTotalRiskI;
Assets_RangeTotalRiskA = (Assets_RangeTotalRiskA == 0) ? 1: Assets_RangeTotalRiskA;

Threats_RangeRelWeightC = (Threats_RangeRelWeightC == 0) ? 1: Threats_RangeRelWeightC;
Threats_RangeRelWeightI = (Threats_RangeRelWeightI == 0) ? 1: Threats_RangeRelWeightI;
Threats_RangeRelWeightA = (Threats_RangeRelWeightA == 0) ? 1: Threats_RangeRelWeightA;
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1702923724162</Id>
					<Name><![CDATA[priorityScoreCalculation]]></Name>
					<X>40</X><Y>260</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[for(Threat t:main.AllThreats){
	t.PriorityScore = roundToDecimal(t.TotalRiskC * t.RelWeightC
					+ t.TotalRiskI * t.RelWeightI
					+ t.TotalRiskA * t.RelWeightA, 4);
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1703101851551</Id>
					<Name><![CDATA[calculateRRScore]]></Name>
					<X>40</X><Y>320</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[for(Countermeasure c:main.AllCountermeasures){
	for(RiskReductionForThreats rrt:c.riskReductionsForThreats){
		if(rrt.ThreatID.equals(main.MostImportantThreat.ID)){
			c.RRScore = 
			roundToDecimal(
			( main.W_RR_C * rrt.RiskReductionC
			+ main.W_RR_I * rrt.RiskReductionI
			+ main.W_RR_A * rrt.RiskReductionA
	  		),4);
	  	}
	 }
}
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1704654037559</Id>
					<Name><![CDATA[calculateCostScore]]></Name>
					<X>40</X><Y>340</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[for(Countermeasure c:main.AllCountermeasures){
			c.CostScore = 
			roundToDecimal(
			(((c.TotalCost-Countermeasures_GlobalMinTotalCost)/Countermeasures_RangeTotalCost)*9+1)
	  		,4);
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1704655288244</Id>
					<Name><![CDATA[calculateTRRCScore]]></Name>
					<X>40</X><Y>360</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[for(Countermeasure c:main.AllCountermeasures){
	c.TRRCScore = 
	roundToDecimal(
		(W_TRRC * c.ThreatsRiskReductionCoverageC +
		W_TRRCI * c.ThreatsRiskReductionCoverageI +
		W_TRRCA * c.ThreatsRiskReductionCoverageA
		)
		,4);
}
]]></Body>
				</Function>
